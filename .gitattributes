# Keep LF-normalized published configuration snapshots stable across Windows and Actions.
/synced-configs/** -text
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Article sources must match the LF text stored in the generated offline bundle.
/assets/content/docs/** text eol=lf
# More-specific rule is repeated last to avoid Git conversion of published snapshots.
/synced-configs/** -text
*.html text eol=lf
/.gitignore text eol=lf
# Generated public notice and crawler files must match their deterministic builders.
/privacy.html text eol=lf
/sitemap.xml text eol=lf
/robots.txt text eol=lf
/assets/content/privacy.json text eol=lf
/assets/content/seo.json text eol=lf
